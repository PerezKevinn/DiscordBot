{
  "name": "massup-bot",
  "version": "1.0.0",
  "description": "MassUp: el centro de mando de tu gremio en Discord para Albion Online",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc",
    "preview:card": "tsx src/utils/previewCard.ts",
    "start:prod": "node dist/index.js",
    "avatar": "tsx scripts/generateAvatar.ts",
    "banner": "tsx scripts/generateBanner.ts",
    "panel:install": "npm --prefix dashboard ci",
    "panel:build": "npm --prefix dashboard run build",
    "panel:dev": "npm --prefix dashboard run dev",
    "items:update": "tsx scripts/buildItemCatalog.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/static": "^10.1.10",
    "@napi-rs/canvas": "^0.1.52",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5",
    "fastify": "^5.12.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
