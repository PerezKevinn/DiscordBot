# Token de tu Bot (Discord Developer Portal -> Bot)
DISCORD_TOKEN=tu_token_aqui

# Application ID de tu Bot
CLIENT_ID=tu_client_id_aqui

# ID de TU servidor: ahí vive /plan-admin y ahí se migra la config antigua (data/config.json)
GUILD_ID=tu_guild_id_aqui

# Tu ID de usuario de Discord (el único que puede usar /plan-admin)
BOT_OWNER_ID=tu_user_id_aqui

# Nombre público del bot (sale en /plan y en el pie de los pings del plan gratis)
BOT_BRAND_NAME=MassUp

# true = registra todos los comandos solo en GUILD_ID (aparecen al instante, para probar)
# false = comandos globales para todos los servidores (producción)
DEV_MODE=true
