# Token de tu Bot (Discord Developer Portal -> Bot)
DISCORD_TOKEN=tu_token_aqui

# Application ID de tu Bot
CLIENT_ID=tu_client_id_aqui

# ID de TU servidor: ahí vive /plan-admin y ahí se migra la config antigua (data/config.json)
GUILD_ID=tu_guild_id_aqui

# Tu ID de usuario de Discord (el único que puede usar /plan-admin)
BOT_OWNER_ID=tu_user_id_aqui

# Nombre público del bot (sale en /plan y en el pie de los pings del plan gratis)
BOT_BRAND_NAME=MassUp

# ID del SKU de la suscripción Premium de servidor (Developer Portal -> Monetización -> SKUs).
# Vacío = no se leen suscripciones de Discord (sigue funcionando Premium manual y por códigos).
PREMIUM_SKU_ID=

# true = registra todos los comandos solo en GUILD_ID (aparecen al instante, para probar)
# false = comandos globales para todos los servidores (producción)
DEV_MODE=true

# ---------- Panel web (opcional) ----------
# Dirección pública del panel, sin barra final. En local: http://localhost:3000
PANEL_URL=https://panel.massup.shop
# Puerto local donde escucha el panel (Caddy/Nginx lo publica con HTTPS)
PANEL_PORT=3000
# Developer Portal -> OAuth2 -> Client Secret (¡secreto! no lo compartas)
DISCORD_CLIENT_SECRET=tu_client_secret_aqui
# Cadena aleatoria de 32+ caracteres para firmar las cookies. Genera una con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=cambia_esto_por_una_cadena_larga_y_aleatoria
